DEMO_MODE=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Prices for the seven models are configured in models.json; verify against provider pricing.
MIN_BENCHMARK_SAMPLES=30
JUDGE_MODEL=gpt-4o-mini
JUDGE_INPUT_PER_M=0.15
JUDGE_OUTPUT_PER_M=0.60
ROUTEGUARD_DB=routeguard.db
API_URL=http://localhost:8000
REQUEST_TIMEOUT=60

# Edit models.json to set current prices in USD per million tokens.
MODEL_CONFIG_PATH=models.json
